# Copia este archivo a .env.local y agrega los mismos valores en Vercel
# (Project Settings → Environment Variables).
# Sanity ya viene configurado en src/sanity/env.js; solo cámbialo si usas otro proyecto.
NEXT_PUBLIC_SANITY_PROJECT_ID=elpqmrtt
NEXT_PUBLIC_SANITY_DATASET=production

# Reseñas de Google (solo servidor; agrégalas también en Vercel)
GOOGLE_PLACES_API_KEY=
# Opcional: ya viene configurado el de Ai Graphics
GOOGLE_PLACE_ID=
