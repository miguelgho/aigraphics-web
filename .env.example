# Copia este archivo a .env.local y agrega los mismos valores en Vercel
# (Project Settings → Environment Variables).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Solo para scripts/importar-fotos-drive.mjs (token "Editor" de sanity.io/manage)
SANITY_API_WRITE_TOKEN=

# Reseñas de Google (solo servidor; agrégalas también en Vercel)
GOOGLE_PLACES_API_KEY=
# Opcional: ya viene configurado el de Ai Graphics
GOOGLE_PLACE_ID=
